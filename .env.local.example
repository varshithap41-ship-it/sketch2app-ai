# ==============================================================================
# Sketch2App AI - Environment Configuration Example
# Copy this file to `.env.local` and fill in your actual credentials.
# Note: Never commit `.env.local` to version control.
# ==============================================================================

# Google Gemini / Google Gen AI API Key (Required)
# Generate your API key in Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model Identifier (Optional, defaults to gemma-4-26b-a4b-it)
# The verified, supported Gemma 4 model for vision & coding tasks.
GEMMA_MODEL=gemma-4-26b-a4b-it
